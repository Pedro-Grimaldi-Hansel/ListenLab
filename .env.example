APP_TIMEZONE=UTC
DB_HOST=127.0.0.1
# Host port. Containers always connect to db:5432 through compose.yaml.
# If Windows blocks 5432, use another available host port, e.g. 15432.
DB_PORT=5432
POSTGRES_DB=listenlab
POSTGRES_USER=listenlab
POSTGRES_PASSWORD=change_me_local

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/spotify/callback

# Relative paths are resolved from the project root. Keep them outside public/.
RAW_STORAGE_PATH=storage/raw
TOKEN_STORAGE_PATH=tokens
REPORT_STORAGE_PATH=storage/reports
RAW_ARCHIVE_PATH=storage/archive
RAW_ARCHIVE_AFTER_DAYS=30
RAW_MAINTENANCE_ENABLED=1
RAW_BACKUP_KEEP=3

# The maximum is a safety budget, not an assertion about Spotify's history window.
SPOTIFY_PAGE_LIMIT=50
SYNC_MAX_PAGES=20
PROBE_MAX_PAGES=100
HTTP_MAX_RETRIES=2
HTTP_MAX_RETRY_WAIT_SECONDS=30
SYNC_INTERVAL_SECONDS=900

# Local collection monitor (open http://127.0.0.1:8787).
MONITOR_PORT=8787
MONITOR_TIMEZONE=America/Sao_Paulo

# Integration tests require a separate database, created by the test instructions.
# TEST_DB_NAME must end in _test and differ from POSTGRES_DB (the main database).
TEST_DB_NAME=listenlab_test
